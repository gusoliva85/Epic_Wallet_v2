{
  "name": "epic-wallet-web",
  "version": "0.1.0",
  "description": "Frontend de Epic Wallet 2.0 — Tailwind CSS v4 sobre los tokens del sistema Vidrio Grafito",
  "private": true,
  "type": "module",
  "author": "Gustavo Oliva <gusoliva85@gmail.com>",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tailwindcss -i web/src/app.css -o web/public/app.css --minify",
    "dev": "node scripts/dev-css.mjs",
    "build:debug": "tailwindcss -i web/src/app.css -o web/public/app.css",
    "size": "node scripts/css-size.mjs",
    "dev:tailwind": "tailwindcss -i web/src/app.css -o web/public/app.css --watch",
    "test": "node --test \"tests/js/*.test.mjs\"",
    "capturas": "node scripts/capturas.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
