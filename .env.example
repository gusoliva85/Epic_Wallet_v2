# ============================================================
#  EPIC WALLET 2.0 · variables de entorno
#
#  Copiar a .env y completar:   cp .env.example .env
#  .env NUNCA se versiona (está en .gitignore). Este archivo sí.
#
#  Verificar que todo quedó bien:  python scripts/check_db.py
#  Referencia: documentacion/02_Documento_Tecnico.md §11
# ============================================================


# ------------------------------------------------------------
#  BASE DE DATOS · un solo proyecto Supabase, dos esquemas
# ------------------------------------------------------------
# Cadena del POOLER, puerto 6543, modo transaction.
# Dónde: panel de Supabase → botón Connect → "Transaction pooler".
#
# Dos cosas que hay que cambiar sobre lo que da el panel:
#   1. el prefijo postgresql://  →  postgresql+psycopg://
#   2. [YOUR-PASSWORD]           →  la contraseña real
#
# Tiene que ser el pooler (6543), no la conexión directa (5432):
# las funciones serverless de Vercel abren y cierran conexiones
# todo el tiempo y agotarían el límite de conexiones directas.
DATABASE_URL=postgresql+psycopg://postgres.PROYECTO:CONTRASENA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Esquema de Postgres donde viven las tablas.
#   dev     → desarrollo y previews (datos de prueba)
#   public  → producción (datos reales)
#
# Con un solo proyecto de Supabase, los esquemas son lo que
# mantiene separados los datos de prueba de los reales. En tu
# máquina esto va SIEMPRE en 'dev'.
DB_SCHEMA=dev

# Alternativa sólo para correr los tests sin red:
# DATABASE_URL=sqlite+pysqlite:///./test.db
# DB_SCHEMA=main


# ------------------------------------------------------------
#  SUPABASE
# ------------------------------------------------------------
# URL del proyecto. Panel → Project Settings → Data API.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave PÚBLICA. En el panel aparece como "anon public" o, en
# proyectos nuevos, como "Publishable key".
# Es la única que viaja al navegador. No es un secreto.
SUPABASE_ANON_KEY=

# Clave de SERVICIO. En el panel: "service_role secret" o
# "Secret keys". Saltea las políticas RLS.
# >>> SECRETA. Sólo backend. Nunca al navegador ni al repositorio.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto con el que Supabase firma los JWT, para que el backend
# pueda verificar las sesiones.
# Panel → Project Settings → API Keys → JWT Keys → "Legacy JWT
# Secret" (o "JWT Settings" según la versión del panel).
# >>> SECRETO. Sólo backend.
SUPABASE_JWT_SECRET=


# ------------------------------------------------------------
#  APLICACIÓN
# ------------------------------------------------------------
# development | preview | production
# Determina, entre otras cosas, qué esquema se espera: en
# production tiene que ser 'public'.
APP_ENV=development

APP_TIMEZONE=America/Argentina/Buenos_Aires

# Separados por coma. En producción, el dominio de Vercel.
# En local, los puertos del frontend y de la API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Orden en que se intentan los proveedores de cotizaciones.
# El último siempre es "manual": es el camino garantizado.
PRICE_PROVIDER_ORDER=byma,public,manual

# Mínimo de minutos entre refrescos de cotizaciones por usuario.
PRICE_REFRESH_COOLDOWN_MINUTES=15

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
